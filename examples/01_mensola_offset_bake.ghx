              <chunks count="1">
                <chunk name="Container">
                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">A panel for custom notes and text values</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">49b7e432-b8e8-4cf3-9b74-5239497e892a</item>
                    <item name="Name" type_name="gh_string" type_code="10">Panel</item>
                    <item name="NickName" type_name="gh_string" type_code="10">01 | Mensola / m / kN</item>
                    <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                    <item name="ScrollRatio" type_name="gh_double" type_code="6">0</item>
                    <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="UserText" type_name="gh_string" type_code="10">1. Sezione rettangolare e acciaio S355.
2. Trave di 4 m, incastro e forza Q=-10 kN.
3. Offset locale di 0.05 m e asse 1 allineato a Z.
4. Un solo Model; preview disattivabile e Brep chiuso per il bake.
Modifica gli slider e osserva sezioni e carichi. Nessuna API Straus richiesta.</item>
                  </items>
