              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Import an existing .st7 into the unified Grasshopper Model. Reads an isolated copy, normalises to m/kN/kPa/tonne/C and preserves distinct coincident nodes. See Report for unsupported attributes. Requires the Straus7 R3 API licence.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">7118468d-ceb8-4542-9095-7e48d659e536</item>
                    <item name="Name" type_name="gh_string" type_code="10">Read Straus Model</item>
