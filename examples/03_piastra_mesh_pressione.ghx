              <chunks count="1">
                <chunk name="Container">
                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">A panel for custom notes and text values</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">1f7780e3-e38a-49d9-a04f-6cd4e880e443</item>
                    <item name="Name" type_name="gh_string" type_code="10">Panel</item>
                    <item name="NickName" type_name="gh_string" type_code="10">03 | Piastra / m / kN</item>
                    <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                    <item name="ScrollRatio" type_name="gh_double" type_code="6">0</item>
                    <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="UserText" type_name="gh_string" type_code="10">Piastra 4 x 3 m suddivisa in 4 Quad4, 9 nodi.
Calcestruzzo C30/37, spessore 0.20 m, offset +0.10 m.
Assi locali allineati a (1,1,0); pressione globale (0,0,-5) kN/m2.
Gli 8 nodi al contorno sono incastrati.
Mesh volutamente grossolana per illustrare i collegamenti; infittire per un'analisi.</item>
                  </items>
