              <chunks count="1">
                <chunk name="Container">
                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">A panel for custom notes and text values</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">963df714-07e9-4952-a053-2a4205c62357</item>
                    <item name="Name" type_name="gh_string" type_code="10">Panel</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Preview e bake</item>
                    <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                    <item name="ScrollRatio" type_name="gh_double" type_code="6">0</item>
                    <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                    <item name="UserText" type_name="gh_string" type_code="10">Preview ON/OFF spegne la visualizzazione gestita.
Display Settings controlla sezioni, carichi, vincoli, offset e assi.
Brep pronti: tasto destro &gt; Bake. Il bake e' manuale.
Le geometrie FEM e il Model restano disponibili anche con preview OFF.</item>
                  </items>
                  <chunks count="2">
