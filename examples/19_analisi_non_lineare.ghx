                  <items count="8">
                    <item name="Description" type_name="gh_string" type_code="10">A panel for custom notes and text values</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">9b1e00e4-1431-4dcb-a2b8-115c8de9e8eb</item>
